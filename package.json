{
  "name": "millennial-burger-place",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "assets": "/Applications/Blender.app/Contents/MacOS/Blender -b --factory-startup --python tools/blender/build_assets.py -- public/models",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
